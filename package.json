		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3-array": "^3.2.2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/js-cookie": "^3.0.6",
		"@types/leaflet": "^1.9.22",
